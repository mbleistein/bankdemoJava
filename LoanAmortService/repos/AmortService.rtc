<?xml version="1.0" encoding="UTF-8" ?>

<mf:application_configuration xmlns:mf="http://xml.microfocus.com/schema/appconfig/v1.0/mfappcfg.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xml.microfocus.com/schema/appconfig/v1.0/mfappcfg.xsd http://xml.microfocus.com/schema/appconfig/v1.0/mfappcfg.xsd">
    <mf:switches>
        <mf:rts_switch name="A" index="1" value="off"/>
        <mf:rts_switch name="D" index="0" value="off"/>
        <mf:rts_switch name="F" index="0" value="on"/>
        <mf:rts_switch name="I" index="2" value="off"/>
        <mf:rts_switch name="O" index="0" value="on"/>
        <mf:rts_switch name="S" index="5" value="off"/>
    </mf:switches>
    <mf:tunables>
        <mf:screen_lines value="25"/>
        <mf:screen_cols value="80"/>
        <mf:default_cancel_mode value="2"/>
    </mf:tunables>
    <mf:deployment>
        <mf:reuse_container value="true"/>
        <mf:reuse_container_after_error value="true"/>
        <mf:app_always_exits value="true"/>
        <mf:output_filtering_enabled value="true"/>
    </mf:deployment>
</mf:application_configuration>
