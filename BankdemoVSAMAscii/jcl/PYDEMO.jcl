//PYDEMO   JOB 'PYTHON-DEMO',CLASS=A,MSGCLASS=A,MSGLEVEL=(1,1)
//*
//PYPROC  PROC PYSCRIPT=,ARGS='',LOGLVL='+I',REGSIZE='0M'
//PYLDM    EXEC PGM=PYLDM,REGION=&REGSIZE,
//             PARM='&LOGLVL &PYSCRIPT &ARGS'
//SYSPRINT DD  SYSOUT=*
//SYSOUT   DD  SYSOUT=*
//STDOUT   DD  SYSOUT=*
//STDERR   DD  SYSOUT=*
//         PEND
//**
//* STEP 1: INVOKE AS A SCRIPT
//*
//STEP1    EXEC PROC=PYPROC,
//             PYSCRIPT='batrpt.py',
//             ARGS='HELLO WORLD'
//STDENV   DD  *
set PYTHONPATH=%BANKROOT%\PYTHON;%PYTHONPATH%
set ESPY_WORKING_DIR=%BANKROOT%\PYTHON
/*
//MAINARGS DD  *
EXTRAARG1 EXTRAARG2
/*
//*
//* STEP 2: INVOKE AS A MODULE
//*
//STEP2    EXEC PROC=PYPROC,
//             PYSCRIPT='-m batrpt',
//             ARGS='module_arg1'
//STDENV   DD  *
set PYTHONPATH=%BANKROOT%\PYTHON;%PYTHONPATH%
set ESPY_WORKING_DIR=%BANKROOT%\PYTHON

/*
