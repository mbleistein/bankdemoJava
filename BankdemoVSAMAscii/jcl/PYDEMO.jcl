//PYDEMO   JOB 'PYTHON-DEMO',CLASS=A,MSGCLASS=A,MSGLEVEL=(1,1)
//*
//PYPROC  PROC PYSCRIPT=,ARGS='',LOGLVL='+I',REGSIZE='0M',LEPARM=''
//PYLDM    EXEC PGM=PYLDM,REGION=&REGSIZE,
//             PARM='&LEPARM/&LOGLVL &PYSCRIPT &ARGS'
//SYSPRINT DD  SYSOUT=*
//SYSOUT   DD  SYSOUT=*
//STDOUT   DD  SYSOUT=*
//STDERR   DD  SYSOUT=*
//         PEND
//*
//* STEP 1: INVOKE AS A SCRIPT
//*
//STEP1    EXEC PROC=PYPROC,
//             PYSCRIPT='BATRPT.PY',
//             ARGS='HELLO WORLD'
//STDENV   DD  *
set PYDEVD_DISABLE_FILE_VALIDATION=1
set ESPY_OUTPUT_ENCODING=ASCII
SET PYTHONPATH=%BANKROOT%\PYTHON;%PYTHONPATH%
SET ESPY_WORKING_DIR=%BANKROOT%\PYTHON
/*
//MAINARGS DD  *
EXTRAARG1 EXTRAARG2
/*
//*
//* STEP 2: INVOKE AS A MODULE
//*
//STEP2    EXEC PROC=PYPROC,
//             PYSCRIPT='-M batrpt',
//             ARGS='module_arg1'
//STDENV   DD  *
set PYDEVD_DISABLE_FILE_VALIDATION=1
set ESPY_OUTPUT_ENCODING=ASCII
SET PYTHONPATH=%BANKROOT%\PYTHON;%PYTHONPATH%
SET ESPY_WORKING_DIR=%BANKROOT%\PYTHON

/*
//
