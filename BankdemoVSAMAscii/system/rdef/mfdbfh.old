<!-- MFDBFH server and database configuration -->
<datastores usevault="false">
  <server name="banksstest" type="sqlserver" access="odbc">
    <dsn name="SS.Master" type="database" dbname="master" connect="Driver={ODBC Driver 17 for SQL Server};Server=(local);Database=master;Uid=mfuser;Pwd=mfuser"/>
  </server>
</datastores>
