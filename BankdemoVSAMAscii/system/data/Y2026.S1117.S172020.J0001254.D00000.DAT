   1 //PYDEMO   JOB 'PYTHON-DEMO',CLASS=A,MSGCLASS=A,MSGLEVEL=(1,1)
   2 //*
   3 //PYPROC  PROC PYSCRIPT=,ARGS='',LOGLVL='+I',REGSIZE='0M'
   4 //PYLDM    EXEC PGM=PYLDM,REGION=&REGSIZE,
   5 //             PARM='&LOGLVL &PYSCRIPT &ARGS'
   6 //SYSPRINT DD  SYSOUT=*
   7 //SYSOUT   DD  SYSOUT=*
   8 //STDOUT   DD  SYSOUT=*
   9 //STDERR   DD  SYSOUT=*
  10 //         PEND
  11 //*
  12 //* STEP 1: INVOKE AS A SCRIPT
  13 //*
  14 //STEP1    EXEC PROC=PYPROC,
  15 //             PYSCRIPT='batrpt.PY',
  16 //             ARGS='HELLO WORLD'
     ++PYPROC  PROC PYSCRIPT=,ARGS='',LOGLVL='+I',REGSIZE='0M'
     ++PYLDM    EXEC PGM=PYLDM,REGION=&REGSIZE,
     SUBSTITUTION - PGM=PYLDM,REGION=0M,
     ++             PARM='&LOGLVL &PYSCRIPT &ARGS'
     SUBSTITUTION - PARM='+I batrpt.PY HELLO WORLD'
     ++SYSPRINT DD  SYSOUT=*
     ++SYSOUT   DD  SYSOUT=*
     ++STDOUT   DD  SYSOUT=*
     ++STDERR   DD  SYSOUT=*
  17 //STDENV   DD  *
  23 //MAINARGS DD  *
  26 //*
  27 //* STEP 2: INVOKE AS A MODULE
  28 //*
  29 //STEP2    EXEC PROC=PYPROC,
  30 //             PYSCRIPT='-m batrpt',
  31 //             ARGS='module_arg1'
     ++PYPROC  PROC PYSCRIPT=,ARGS='',LOGLVL='+I',REGSIZE='0M'
     ++PYLDM    EXEC PGM=PYLDM,REGION=&REGSIZE,
     SUBSTITUTION - PGM=PYLDM,REGION=0M,
     ++             PARM='&LOGLVL &PYSCRIPT &ARGS'
     SUBSTITUTION - PARM='+I -m batrpt module_arg1'
     ++SYSPRINT DD  SYSOUT=*
     ++SYSOUT   DD  SYSOUT=*
     ++STDOUT   DD  SYSOUT=*
     ++STDERR   DD  SYSOUT=*
  32 //STDENV   DD  *
