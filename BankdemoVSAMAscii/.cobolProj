            <deploy_settings>
               <options>
                  <option id="deployFolder" name="deploySettings" value="deploy"/>
                  <option id="cleanAllowed" name="deploySettings" value="cleanAllowed"/>
                  <option id="deployFiles" name="deploySettings" value=""/>
